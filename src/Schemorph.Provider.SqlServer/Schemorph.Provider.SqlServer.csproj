<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Schemorph.Core\Schemorph.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.DacFx" Version="170.5.96" />
    <!-- Raises a transitive dependency past a security advisory: DacFx 170.5.96 brings Microsoft.Data.SqlClient 6.1.5,
         which brings System.Security.Cryptography.Pkcs 9.0.11 (CVE-2026-84008, fixed in 9.0.21 and 10.0.13).
         Remove once DacFx carries a patched one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Schemorph.Provider.SqlServer.Tests" />
  </ItemGroup>

</Project>
